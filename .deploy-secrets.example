# ==============================================
# DEPLOY SECRETS - Copy to .deploy-secrets
# ==============================================
# DO NOT commit the actual .deploy-secrets file!
# This template is safe to commit.

# ---- MongoDB Atlas (for running migrations) ----
# Your production MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/coordination_matrix?retryWrites=true&w=majority

# ---- Cloudflare (for frontend deploy) ----
# Create API token at: https://dash.cloudflare.com/profile/api-tokens
# Required permission: Cloudflare Pages > Edit
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
# Account ID: found in Cloudflare dashboard URL or Workers & Pages overview
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# ---- Render (optional — for deploy status verification & error logs) ----
# The backend deploy is triggered by pushing to the prod branch on GitHub.
# Render auto-deploys from that push. These keys are ONLY used to poll
# deploy status and fetch logs when something goes wrong.
# If omitted, the deploy step will still push to prod and report success.
# Create API key at: https://dashboard.render.com/settings#api-keys
RENDER_API_KEY=rnd_xxxxxxxxxxxxxxxxxxxx
# Service ID: from your Render dashboard URL (e.g., srv-xxxxxxxxxx)
RENDER_SERVICE_ID=srv_xxxxxxxxxxxxxxxxxxxx

# ---- Production URLs (for verification) ----
# PROD_BACKEND_URL is the public-facing URL. Note: cm.hcizero.com serves the
# frontend at root and proxies /api/* to Render. The backend /health endpoint
# is NOT reachable at cm.hcizero.com/health (Cloudflare Pages handles that path).
PROD_BACKEND_URL=https://cm.hcizero.com
PROD_FRONTEND_URL=https://coordination-matrix.pages.dev

# ---- Optional: Direct Render URL for health checks ----
# The direct Render service URL, bypassing Cloudflare. Used by the verify step
# to hit the backend /health endpoint directly. Find this in your Render dashboard.
# If omitted, backend health is checked via authenticated API request instead.
# RENDER_HEALTH_URL=https://your-service.onrender.com

# ---- Optional: API key for authenticated health checks ----
# Get from your Coordination Matrix API key settings
PROD_API_KEY=cm_ak_live_xxxxxxxxxxxxx
