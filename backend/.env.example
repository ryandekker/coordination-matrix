# ========================================
# BACKEND ENVIRONMENT CONFIGURATION
# ========================================
# Copy this file to .env and update the values

# ----------------------------------------
# REQUIRED FOR PRODUCTION
# ----------------------------------------

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.xxxxx.mongodb.net/coordination_matrix?retryWrites=true&w=majority

# CRITICAL: Generate a strong random secret (min 32 chars)
# Example: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_generate_a_strong_random_secret_here

# ----------------------------------------
# SERVER CONFIGURATION
# ----------------------------------------
NODE_ENV=production
PORT=3001

# Your frontend domain (for CORS)
CORS_ORIGIN=https://your-frontend-domain.com

# Public URL of this backend API (for webhook callback URLs)
# This should be the externally accessible URL
BASE_URL=https://api.your-domain.com

# ----------------------------------------
# OPTIONAL - AI FEATURES
# ----------------------------------------

# OpenAI API key for embeddings/semantic search (optional)
# If not set, AI-powered features will be disabled
OPENAI_API_KEY=sk-your-openai-api-key

# ----------------------------------------
# OPTIONAL - VARIABLE PACKAGE ENCRYPTION
# ----------------------------------------

# Encryption key for variable package secrets (32 bytes, base64 encoded)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If not set, secret fields cannot be used in variable packages
VARIABLE_ENCRYPTION_KEY=

# ----------------------------------------
# OPTIONAL - DEVELOPMENT/DEBUGGING
# ----------------------------------------

# Disable rate limiting (NOT recommended for production)
# DISABLE_RATE_LIMIT=true
