# ========================================
# LOCAL DEVELOPMENT
# ========================================

# MongoDB Configuration (local Docker)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=adminpassword

# Mongo Express (optional admin UI)
MONGOEXPRESS_USER=admin
MONGOEXPRESS_PASSWORD=admin

# ========================================
# SHARED CONFIGURATION
# ========================================

# Backend Configuration
NODE_ENV=development
JWT_SECRET=your-jwt-secret-change-in-production
# PORT=3001
CORS_ORIGIN=http://localhost:3000

# Backend public URL (used by {{_apiUrl}} template variable in workflows)
# For local dev, this should match your PORT
BASE_URL=http://localhost:3100

# System API key for workflow external steps (used by {{_apiKey}} template variable)
# This allows workflows to call internal APIs. Generate a key via the API keys UI.
# MATRIX_API_KEY=cm_ak_your_api_key_here

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3100/api
NEXT_PUBLIC_APP_NAME=Coordination Matrix

# ========================================
# PRODUCTION (MongoDB Atlas + AWS)
# ========================================
# Uncomment and configure for production:

# MONGODB_URI=mongodb+srv://username:password@coordination-matrix.kq1jb98.mongodb.net/coordination_matrix?retryWrites=true&w=majority
# NODE_ENV=production
# JWT_SECRET=generate-a-strong-random-secret-here
# CORS_ORIGIN=https://your-frontend-domain.com

# For Cloudflare Pages frontend:
# NEXT_PUBLIC_API_URL=https://api.your-domain.com/api

# Backend public URL (for webhook callbacks - must be externally accessible)
# BASE_URL=https://api.your-domain.com
